
#include <stdio.h>

int main()
{
    int n, digit, i = 0;
    char str[20];

    printf("Enter an integer: ");
    scanf("%d", &n);

    if (n == 0)
    {
        str[i++] = '0';
    }
    else
    {
        if (n < 0)
        {
            str[i++] = '-';
            n = -n;
        }

        int start = i;

        while (n > 0)
        {
            digit = n % 10;
            str[i++] = digit + '0';
            n = n / 10;
        }

        int end = i - 1;

        while (start < end)
        {
            char temp = str[start];
            str[start] = str[end];
            str[end] = temp;

            start++;
            end--;
        }
    }

    str[i] = '\0';

    printf("String = %s\n", str);

    return 0;
}
