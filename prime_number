#include<stdio.h>
int main(){
    int n,f=0;
    scanf("%d",&n);
    if(n<2){
        printf("Not Prime");
    }
    else{
    for(int i=2;i<n;i++){
        if(n%i==0){
            f=1;
            break;
        }
    }
    if(f==0){
        printf("Prime");
    }
    else{
        printf("Not Prime");
    }
}     
}