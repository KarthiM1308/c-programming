//Frequency of Digits in a Number

#include <stdio.h>

void countFrequency(int n, int freq[])
{
    if (n == 0)
    {
        freq[0]++;
        return;
    }

    while (n > 0)
    {
        int digit = n % 10;
        freq[digit]++;
        n = n / 10;
    }
}

int main()
{
    int n;
    int freq[10] = {0};

    printf("Enter an integer: ");
    scanf("%d", &n);

    countFrequency(n, freq);

    printf("Digit Frequency:\n");

    for (int i = 0; i < 10; i++)
    {
        printf("%d = %d\n", i, freq[i]);
    }

    return 0;
}