// perfect Number

#include<stdio.h>
int pf(int n){
    int sum=0;
    for(int i=1;i<n;i++){
        if(n%i==0){
            sum+=i;
        }
    }
    return sum;
}
int main(){
    int n,sum;
    scanf("%d",&n);
    sum=pf(n);
    if(n==sum){
        printf("Perfect Number");
    }
    else{
        printf("Not Perfect Number");
    }


}